# Copy this file to .env and fill in local values.
# .env is gitignored. Do not commit real secrets.

# Telegram bot token from BotFather.
BOT_TOKEN=

# Optional AI settings (OpenAI-compatible). Omit all three to run without AI.
# Gemini OpenAI-compatible endpoint:
# POST {AI_BASE_URL}/chat/completions
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.0-flash

# Optional daily token budgets (UTC). Defaults shown.
AI_DAILY_TOKEN_LIMIT=200000
AI_CHAT_DAILY_TOKEN_LIMIT=40000
AI_MAX_OUTPUT_TOKENS=2048

# Optional risk calculator limits. Defaults shown.
RISK_MAX_PERCENT=2
RISK_MAX_LOTS=2
# Max user-reported realized loss per chat per UTC day (not a live P/L feed).
RISK_MAX_DAILY_LOSS=100

# Live bid/ask. Leave unset to keep quotes unavailable.
# The only registered adapter is biquote. It reads https://biquote.io/api/EURUSD and needs no key.
# A quote is accepted only when symbol, bid, ask, and timestamp validate and the market is open.
# LIVE_QUOTE_PROVIDER=biquote

# Local dashboard. It binds to 127.0.0.1 only.
# POST /api/decision requires DASHBOARD_TOKEN. Leave it unset to keep assessments off.
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
